# Environment Variables Template
# Copy this file to .env.development and update the values for your environment

# Environment
NODE_ENV=development

# Server Configuration
PORT=8081

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/audiobook_dev

HEALTH_SUPPORT_EMAIL=no-reply@srota-support.com
HEALTH_SUPPORT_PASSWORD=

# Security
SESSION_SECRET=

# Health API (separate from JWT auth — @srota-support.com only)
HEALTH_SUPPORT_EMAIL=no-reply@srota-support.com
HEALTH_SUPPORT_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_PREFIX=audiobook

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Storage
STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_SIGNED_URL_EXPIRES_IN=3600

# Streaming
TRANSCODING_BITRATES=[64, 128, 256]
STREAMING_CACHE_TTL=3600
# Absolute path or path relative to app-service cwd (dev: ../srota-streaming-services/storage)
STREAMING_SERVICE_STORAGE_PATH=../srota-streaming-services/storage
STREAMING_SERVICE_URL=http://localhost:8082/api/v1/stream

# Auth Service
AUTH_SERVICE_URL=http://localhost:8080
JWKS_ENDPOINT=http://localhost:8080/auth/.well-known/jwks.json

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Reverse Geocoding
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=AudioBookApp/1.0 (profile-location-resolver)

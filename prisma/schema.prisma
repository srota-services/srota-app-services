// AudioBook Backend Prisma Schema
// This schema defines the database structure for the AudioBook application

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AudioBookOwnerType {
  AUTHOR
  ORGANIZATION
}

/// STI discriminator — PublicationAudiobook vs AuthoringAudiobook share the audiobooks table.
enum AudiobookType {
  PUBLICATION
  AUTHORING
}

// AudioBook model for storing book information
model AudioBook {
  id          String  @id @default(cuid())
  title       String
  author      String
  narrator    String?
  description String?

  /// STI discriminator (PublicationAudiobook | AuthoringAudiobook)
  type AudiobookType @default(PUBLICATION)

  // Media information
  duration   Int? // Duration in seconds (calculated from chapters)
  fileSize   BigInt? // File size in bytes
  coverImage String? // URL to cover image

  // Polymorphic owner (auth-service Author or Organization id)
  ownerType AudioBookOwnerType
  ownerId   String

  // Metadata
  languageId String
  publisher  String?
  publishDate    DateTime?
  isbn           String?   @unique

  // Status
  isActive Boolean @default(true)
  isPublic Boolean @default(true)

  // Subscription gating: minimum subscription tier required to access this
  // audiobook when subscriptionGatingMode is AUDIOBOOK. `null` when mode is
  // NONE or CHAPTER. Compared against auth SubscriptionPlan.tierLevel.
  subscriptionGatingMode SubscriptionGatingMode @default(NONE)
  minSubscriptionTier    SubscriptionTierLevel?

  // Offline availability
  isOfflineAvailable Boolean @default(false)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scheduledAt DateTime? // Optional scheduled date/time

  // Mood (each audiobook has at most one mood)
  moodId String?

  // Relations
  language         Language           @relation(fields: [languageId], references: [id], onDelete: Restrict)
  mood             Mood?              @relation(fields: [moodId], references: [id], onDelete: SetNull)
  userAudioBooks   UserAudioBook[]
  reviews          Review[]
  favorites        Favorite[]
  playlistItems    PlaylistItem[]
  listeningHistory ListeningHistory[]
  chapters         Chapter[]
  notes            Note[]
  offlineDownloads OfflineDownload[]
  audiobookTags    AudioBookTag[]
  audioBookGenres  AudioBookGenre[]
  comments         Comment[]

  @@index([ownerType, ownerId])
  @@index([moodId])
  @@index([languageId])
  @@index([type])
  @@map("audiobooks")
}

// Mood model for audiobook atmosphere / tone
model Mood {
  id              String  @id @default(cuid())
  name            String  @unique
  description     String?
  purpose         String  @default("")
  descriptionIcon String  @map("description_icon")
  hexcode         String
  icon            String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  audiobooks     AudioBook[]
  moodAttributes MoodAttribute[]

  @@map("moods")
}

// Attributes describing facets of a mood (icon + description per attribute)
model MoodAttribute {
  id          String @id @default(cuid())
  moodId      String
  icon        String
  description String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  mood Mood @relation(fields: [moodId], references: [id], onDelete: Cascade)

  @@index([moodId])
  @@map("mood_attributes")
}

// Genre model for categorizing audiobooks
model Genre {
  id   String @id @default(cuid())
  name String @unique

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  audioBookGenres AudioBookGenre[]

  @@map("genres")
}

// Official language catalog (Eighth Schedule Indian languages)
model Language {
  id   String @id @default(cuid())
  name String @unique
  code String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audiobooks AudioBook[]

  @@map("languages")
}

model OrganizationTier {
  id             String              @id @default(cuid())
  organizationId String              @unique
  tier           ReputationTierLevel   @default(TIER_3)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@map("organization_tiers")
}

model AuthorTier {
  id        String              @id @default(cuid())
  authorId  String              @unique
  tier      ReputationTierLevel   @default(TIER_3)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@map("author_tiers")
}

model OrganizationReview {
  id             String       @id @default(cuid())
  organizationId String
  reviewerType   ReviewerType
  reviewerId     String
  rating         Int
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, reviewerType, reviewerId])
  @@index([organizationId])
  @@map("organization_reviews")
}

model AuthorReview {
  id           String       @id @default(cuid())
  authorId     String
  reviewerType ReviewerType
  reviewerId   String
  rating       Int
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([authorId, reviewerType, reviewerId])
  @@index([authorId])
  @@map("author_reviews")
}

// Junction table for many-to-many relationship between AudioBook and Genre
model AudioBookGenre {
  id          String @id @default(cuid())
  audiobookId String
  genreId     String

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  audiobook AudioBook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  genre     Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([audiobookId, genreId])
  @@map("audiobook_genres")
}

// Junction table for user-audiobook relationships (ownership, purchases)
model UserAudioBook {
  id            String @id @default(cuid())
  userId String
  audiobookId   String

  // Relationship type: OWNED (creator on audiobook create) or PURCHASED (all other cases)
  type UserAudioBookType @default(PURCHASED)

  // User-specific progress (updated by background job): total seconds listened across chapters
  progress Float @default(0.0)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  audiobook   AudioBook   @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, audiobookId])
  @@map("user_audiobooks")
}

// Playlist model for organizing audiobooks
model Playlist {
  id          String  @id @default(cuid())
  name        String
  description String?
  isPublic    Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userId String
  items         PlaylistItem[]

  @@map("playlists")
}

// Playlist items (many-to-many between playlists and audiobooks)
model PlaylistItem {
  id          String @id @default(cuid())
  playlistId  String
  audiobookId String
  position    Int // Order in playlist

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  playlist  Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  audiobook AudioBook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([playlistId, audiobookId])
  @@map("playlist_items")
}

// Review model for user reviews (rating only)
model Review {
  id            String @id @default(cuid())
  userId String
  audiobookId   String
  rating        Int // 1-5 stars

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  audiobook   AudioBook   @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, audiobookId])
  @@map("reviews")
}

// Comment model for audiobook discussion with nested replies
model Comment {
  id            String  @id @default(cuid())
  userId String
  audiobookId   String
  parentId      String?
  content       String
  meta          Json? // { position: number } — playback position in seconds

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  audiobook   AudioBook   @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  parent      Comment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]   @relation("CommentReplies")

  @@index([audiobookId])
  @@index([parentId])
  @@map("comments")
}

// Favorites model for user's favorite audiobooks
model Favorite {
  id            String @id @default(cuid())
  userId String
  audiobookId   String

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  audiobook   AudioBook   @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, audiobookId])
  @@map("favorites")
}

enum SourceUploadStatus {
  pending
  ready
  failed
}

enum SubscriptionGatingMode {
  NONE
  AUDIOBOOK
  CHAPTER
}

enum SubscriptionTierLevel {
  BASE
  STANDARD
  PREMIUM
}

enum ReputationTierLevel {
  TIER_1
  TIER_2
  TIER_3
  TIER_4
  TIER_5
}

enum ReviewerType {
  USER
  AUTHOR
  ORGANIZATION
}

// Chapter model for audiobook chapters
model Chapter {
  id          String  @id @default(cuid())
  audiobookId String
  title       String
  description String?

  // Chapter metadata
  chapterNumber Int // Order of chapter in audiobook
  duration      Int? // Duration in seconds (publication chapters)
  filePath      String? // Path to chapter audio file (publication chapters)
  fileSize      BigInt? // File size in bytes (publication chapters)
  coverImage    String? // URL to chapter cover image (required for publication chapters)

  // Chapter start/end positions in main audiobook file (publication chapters)
  startPosition Int?
  endPosition   Int?

  // Subscription gating when parent audiobook subscriptionGatingMode is CHAPTER.
  // All chapters in an audiobook must share the same minSubscriptionTier.
  minSubscriptionTier SubscriptionTierLevel?

  // Status
  isActive             Boolean            @default(false)
  transcodingReady     Boolean            @default(false)
  sourceUploadStatus   SourceUploadStatus @default(ready)
  sourceUploadError    String?

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scheduledAt DateTime? // Optional scheduled date/time

  // Relations
  audiobook       AudioBook         @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  chapterProgress ChapterProgress[]
  bookmarks       Bookmark[]
  notes           Note[]
  pages           Page[]

  @@map("chapters")
}

// Authoring-mode page content (one page of a chapter manuscript)
model Page {
  id         String @id @default(cuid())
  chapterId  String
  pageNumber Int
  plainText  String @db.Text
  richText   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, pageNumber])
  @@index([chapterId])
  @@map("pages")
}

// Chapter progress tracking for individual users
model ChapterProgress {
  id            String @id @default(cuid())
  userId String
  chapterId     String

  // Progress tracking
  currentPosition Int // Current position in seconds within chapter
  completed       Boolean  @default(false)
  lastListenedAt  DateTime @default(now())

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  chapter     Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@map("chapter_progress")
}

// Bookmarks for chapters (saved chapter per user)
model Bookmark {
  id            String @id @default(cuid())
  userId String
  chapterId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chapter     Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([chapterId])
  @@map("bookmarks")
}

// Notes for audiobooks and chapters
model Note {
  id            String  @id @default(cuid())
  userId String
  audiobookId   String?
  chapterId     String?

  // Note details
  title     String?
  content   String
  position  Int? // Position in seconds (optional)
  timestamp DateTime @default(now())

  audiobook AudioBook? @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  // Timestamps
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  chapter     Chapter?    @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@map("notes")
}

// Offline downloads tracking
model OfflineDownload {
  id            String @id @default(cuid())
  userId String
  audiobookId   String

  // Download status
  status   DownloadStatus @default(PENDING)
  progress Float          @default(0.0) // Download progress percentage
  filePath String? // Local file path when downloaded
  fileSize BigInt? // Downloaded file size

  // Error handling
  errorMessage String?
  retryCount   Int     @default(0)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  audiobook   AudioBook   @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, audiobookId])
  @@map("offline_downloads")
}

// Listening history for tracking user progress
model ListeningHistory {
  id            String @id @default(cuid())
  userId String
  audiobookId   String

  // Progress tracking
  currentPosition Int // Current position in seconds
  completed       Boolean  @default(false)
  lastListenedAt  DateTime @default(now())

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  audiobook   AudioBook   @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, audiobookId])
  @@map("listening_history")
}

// Tags model for categorizing audiobooks
model Tag {
  id   String @id @default(cuid())
  name String @unique

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  audiobookTags AudioBookTag[]

  @@map("tags")
}

// Junction table for audiobook-tag relationships
model AudioBookTag {
  id          String @id @default(cuid())
  audiobookId String
  tagId       String

  // Timestamps
  createdAt DateTime @default(now())

  // Relations
  audiobook AudioBook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([audiobookId, tagId])
  @@map("audiobook_tags")
}

// Enums
enum UserAudioBookType {
  OWNED
  PURCHASED
}

enum DownloadStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum ImageCategory {
  audiobook
  chapter
}

model ImagePlaceholderSpec {
  id                   String        @id @default(cuid())
  category             ImageCategory
  variantKey           String
  actualWidth          Int
  actualHeight         Int
  aspectRatioWidth     Int
  aspectRatioHeight    Int
  recommendedMaxWidth  Int
  recommendedMaxHeight Int

  @@unique([category, variantKey])
  @@map("image_placeholder_specs")
}

model ImageAsset {
  id          String        @id @default(cuid())
  category    ImageCategory
  entityId    String
  variantKey  String
  storageKey  String
  width       Int
  height      Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([category, entityId, variantKey])
  @@index([category, entityId])
  @@map("image_assets")
}
